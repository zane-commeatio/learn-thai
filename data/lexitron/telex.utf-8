<Doc>
<tsearch>จุดมุ่งหมาย</tsearch>
<tentry>จุดมุ่งหมาย</tentry>
<eentry>aim</eentry>
<tcat>N</tcat>
<tenglish>intention; purpose; objective; goal</tenglish>
