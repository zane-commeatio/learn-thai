<tentry>ให้ยืม</tentry>
<eentry>lend</eentry>
<tcat>V</tcat>
<tant>ยืม, ขอยืม</tant>
<tsample>เจ้าของร้านเอื้อเฟื้อให้ยืมสถานที่โดยไม่คิดค่าเช่า</tsample>
<id>39765</id>
</Doc>
<Doc>
