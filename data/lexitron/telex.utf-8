<tcat>ADJ</tcat>
<tenglish>unsure</tenglish>
<tsyn>รวนเร, โลเล, ลังเล</tsyn>
<tdef>ไม่แน่นอน, ไม่แน่ใจ</tdef>
<id>17183</id>
</Doc>
<Doc>
