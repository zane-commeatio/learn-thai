<eentry>buildings</eentry>
<tcat>N</tcat>
<tsyn>ตึก</tsyn>
<tsample>เพียงสิบกว่านาที เมื่อเดินออกถึงถนนใหญ่กลับเต็มไปด้วยตึกรามที่โอ่อ่า</tsample>
<tnum>หลัง, ตึก</tnum>
<id>22752</id>
