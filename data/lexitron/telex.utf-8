<tentry>ทิ้งตัว</tentry>
<eentry>sit down</eentry>
<tcat>V</tcat>
<tenglish>throw the body down</tenglish>
<tant>ลุกขึ้น</tant>
<tsample>อินทร์ทิ้งตัวลงบนเก้าอี้โซฟา</tsample>
<id>24670</id>
</Doc>
<Doc>
