<eentry>twisted</eentry>
<tcat>ADJ</tcat>
<tenglish>distorted</tenglish>
<tsyn>หงิกงอ</tsyn>
<tsample>ฉันเห็นล้อที่บิดเบี้ยวขนาดนั้นแล้วคิดว่าคนขับคงไม่รอดแน่</tsample>
