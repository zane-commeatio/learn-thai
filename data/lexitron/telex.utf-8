<tentry>ซุ่มเสียง</tentry>
<eentry>voice</eentry>
<tcat>N</tcat>
<tsyn>สุ้มเสียง, กระแสเสียง</tsyn>
<tsample>เธอชอบดัดซุ่มเสียงให้เล็กแหลมอย่างนักร้อง</tsample>
<id>28937</id>
</Doc>
