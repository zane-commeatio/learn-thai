<id>16633</id>
</Doc>
<Doc>
<tsearch>แปลงร่าง</tsearch>
<tentry>แปลงร่าง</tentry>
<eentry>impersonate</eentry>
<tcat>V</tcat>
<tenglish>incarnate; embody;  transform; personate; transfigure; disguise</tenglish>
