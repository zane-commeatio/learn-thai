<id>22543</id>
</Doc>
<Doc>
<tsearch>ต่อ</tsearch>
<tentry>ต่อ 2</tentry>
<eentry>concede</eentry>
<tcat>V</tcat>
<tenglish>surrender; allow</tenglish>
<tsample>ผมต่อให้คุณวิ่งไปก่อน 100 เมตร</tsample>
<tdef>ท้าพนันโดยยอมลดเปรียบให้ เช่น ต่อให้</tdef>
