<tsearch>ส่งกลับ</tsearch>
<tentry>ส่งกลับ</tentry>
<eentry>return</eentry>
<tcat>V</tcat>
<tenglish>restore; give back; deliver back; send back; payback; refund; restore; revert; render</tenglish>
