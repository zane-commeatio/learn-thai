<tentry>ไม่แน่</tentry>
<eentry>perhaps</eentry>
<tcat>ADV</tcat>
<tenglish>maybe</tenglish>
<tsample>ไม่แน่เขาอาจจะมาก็ได้</tsample>
<id>38810</id>
</Doc>
<Doc>
