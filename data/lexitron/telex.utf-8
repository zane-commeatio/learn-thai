<eentry>nearly-dead fish</eentry>
<tcat>N</tcat>
<tenglish>dying fish</tenglish>
<tdef>ปลาที่จวนจะตาย</tdef>
<tnum>ตัว</tnum>
<id>37192</id>
</Doc>
<Doc>
