</Doc>
<Doc>
<tsearch>ภิกขา</tsearch>
<tentry>ภิกขา</tentry>
<eentry>begged food</eentry>
<tcat>N</tcat>
<tenglish>begged alms</tenglish>
<tsyn>ภิกษา</tsyn>
<tdef>อาหารที่ขอมา</tdef>
<notes>(บาลี/สันสกฤต)</notes>
<id>98</id>
</Doc>
<Doc>
