<tentry>สลับฟันปลา</tentry>
<eentry>zigzag</eentry>
<tcat>N</tcat>
<tsyn>ซิกแซ็ก</tsyn>
<tsample>ขาใน 3 แถวนี้เยื้องกันโดยทำมุม 60 องศา หรือคือสลับฟันปลา</tsample>
<id>12161</id>
</Doc>
