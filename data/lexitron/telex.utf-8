</Doc>
<Doc>
<tsearch>ความสอดคล้อง</tsearch>
<tentry>ความสอดคล้อง</tentry>
<eentry>accordance</eentry>
<tcat>N</tcat>
<tenglish>consistency; compatible</tenglish>
