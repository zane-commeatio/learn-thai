<eentry>valued friend</eentry>
<tcat>N</tcat>
<tenglish>bosom friend; close friend</tenglish>
<tsyn>เพื่อนรัก, เพื่อนสนิท</tsyn>
<tsample>ไม่มีใครเป็นมิ่งมิตรที่ดีได้เท่าเธอ</tsample>
<tnum>คน</tnum>
<id>16055</id>
