<tentry>รากเลือด</tentry>
<eentry>vomit blood</eentry>
<tcat>V</tcat>
<tenglish>spit blood</tenglish>
<tdef>อาเจียนเป็นเลือด</tdef>
<id>1294</id>
</Doc>
<Doc>
