<tdef>ถอดเครื่องนุ่งห่มออกจากร่างกาย</tdef>
<id>16482</id>
</Doc>
<Doc>
<tsearch>เปลือย</tsearch>
<tentry>เปลือย</tentry>
<eentry>uncover</eentry>
<tcat>V</tcat>
<tenglish>bare; reveal; expose</tenglish>
<tsyn>เปิด, เปิดเผย, เปิดใจ</tsyn>
