<tentry>สมทรง</tentry>
<eentry>fitting</eentry>
<tcat>ADJ</tcat>
<tenglish>suitable</tenglish>
<tdef>เหมาะกับรูปร่าง</tdef>
<id>12142</id>
</Doc>
<Doc>
