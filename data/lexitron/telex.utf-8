<tdef>ป้ายบอกชื่อยา ใช้ปิดขวดยารักษาโรค</tdef>
<tnum>แผ่น</tnum>
<id>8712</id>
</Doc>
<Doc>
<tsearch>ฉายานาม</tsearch>
<tentry>ฉายานาม</tentry>
<eentry>designation</eentry>
<tcat>N</tcat>
<tenglish>nickname; alias</tenglish>
<tsyn>สมญานาม</tsyn>
