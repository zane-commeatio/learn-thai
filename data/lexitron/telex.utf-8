<Doc>
<tsearch>ม้าลาย</tsearch>
<tentry>ม้าลาย</tentry>
<eentry>zebra crossing</eentry>
<tcat>N</tcat>
<tenglish>pedestrian crossing; crosswalk</tenglish>
