<eentry>office</eentry>
<tcat>N</tcat>
<tenglish>studio</tenglish>
<tsample>เขาเดินนำหน้าเธอเข้าไปในห้องทำงาน ซึ่งค่อนข้างจะมิดชิด</tsample>
