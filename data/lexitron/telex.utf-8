<tentry>พวน 1</tentry>
<eentry>hawser</eentry>
<tcat>N</tcat>
<tenglish>rope; cable</tenglish>
<tsyn>เชือกพวน</tsyn>
<tsample>พวกเขาเตรียมพวนไปจำนวนมากสำหรับการดักช้างป่า</tsample>
<tdef>เชือกเกลียวขนาดใหญ่</tdef>
<tnum>เส้น</tnum>
<id>14397</id>
</Doc>
