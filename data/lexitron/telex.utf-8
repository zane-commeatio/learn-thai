<tentry>ฝังดิน</tentry>
<eentry>bury</eentry>
<tcat>V</tcat>
<tenglish>inter</tenglish>
<tsyn>ฝัง</tsyn>
<tsample>คนอยุธยาสมัยก่อนนิยมเอาทรัพย์ใส่ตุ่มฝังดิน</tsample>
<tdef>จมหรือทำให้จมลงในดิน</tdef>
<id>13821</id>
