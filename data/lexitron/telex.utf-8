<tsearch>สะพาน</tsearch>
<tentry>สะพาน</tentry>
<eentry>bridge</eentry>
<tcat>N</tcat>
<tenglish>flyover; overpass; viaduct</tenglish>
<tsyn>ตะพาน</tsyn>
